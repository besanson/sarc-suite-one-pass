--- a/paper-tex/gates/run_gates.py
+++ b/paper-tex/gates/run_gates.py
@@ -101,6 +101,26 @@ def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess:
 # Set SARC_LATEX_COMPILER=tectonic|latexmk to force a choice; otherwise
 # Tectonic is preferred when both are on PATH.
 COMPILER_ENV_VAR = "SARC_LATEX_COMPILER"
+SOURCE_DATE_EPOCH_FALLBACK = "1786838400"  # 2026-08-16 00:00:00 UTC
+
+
+def _reproducible_build_env() -> dict[str, str]:
+    """Return a stable build environment for byte-reproducible PDFs.
+
+    Prefer the checked-out commit timestamp so a release commit carries its
+    own reproducible epoch. The fixed publication-date fallback keeps source
+    archives and non-git exports deterministic too.
+    """
+    env = os.environ.copy()
+    if "SOURCE_DATE_EPOCH" not in env:
+        head_time = run(
+            ["git", "show", "-s", "--format=%ct", "HEAD"],
+            cwd=str(REPO_ROOT),
+        )
+        epoch = head_time.stdout.strip() if head_time.returncode == 0 else ""
+        env["SOURCE_DATE_EPOCH"] = epoch if epoch.isdigit() else SOURCE_DATE_EPOCH_FALLBACK
+    env.setdefault("TZ", "UTC")
+    return env
 
 # Undefined-reference/citation warnings: verified identical wording under
 # `tectonic --print` and under latexmk/pdflatex, both being the same
@@ -162,9 +182,17 @@ def _run_compiler_once(compiler: str) -> tuple[int, str]:
         # that Tectonic otherwise suppresses entirely (verified directly:
         # a plain `tectonic main.tex` build with a deliberately broken
         # \ref/\cite produced no warning output at all).
-        r = run(["tectonic", "--print", "main.tex"], cwd=str(PAPER_TEX_DIR))
+        r = run(
+            ["tectonic", "--print", "main.tex"],
+            cwd=str(PAPER_TEX_DIR),
+            env=_reproducible_build_env(),
+        )
     elif compiler == "latexmk":
-        r = run(["latexmk", "-pdf", "-interaction=nonstopmode", "main.tex"], cwd=str(PAPER_TEX_DIR))
+        r = run(
+            ["latexmk", "-pdf", "-interaction=nonstopmode", "main.tex"],
+            cwd=str(PAPER_TEX_DIR),
+            env=_reproducible_build_env(),
+        )
     else:
         raise RuntimeError(f"unsupported compiler {compiler!r}")
     return r.returncode, f"{r.stdout or ''}\n{r.stderr or ''}"
@@ -200,9 +228,15 @@ def _do_one_build(compiler: str) -> dict:
